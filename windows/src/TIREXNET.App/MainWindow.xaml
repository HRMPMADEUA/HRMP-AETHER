<Window x:Class="TIREXNET.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TIREXNET.UI"
        Title="TIREXNET" Width="1120" Height="780" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        Background="{StaticResource Bg0}"
        Closing="OnClosing" StateChanged="OnStateChanged" SourceInitialized="OnSourceInitialized" Loaded="OnWindowLoaded">
  <Window.Triggers>
    <!-- Ambient background: three soft blobs drift slowly (like AmbientBackground.kt) -->
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Blob1T" Storyboard.TargetProperty="X" From="-30" To="70" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="Blob1T" Storyboard.TargetProperty="Y" From="-20" To="50" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="Blob2T" Storyboard.TargetProperty="X" From="40" To="-60" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="Blob2T" Storyboard.TargetProperty="Y" From="30" To="-40" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="Blob3T" Storyboard.TargetProperty="X" From="-50" To="40" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="Blob3T" Storyboard.TargetProperty="Y" From="20" To="-50" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="OrbPulse" Storyboard.TargetProperty="ScaleX" From="1" To="1.012" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="OrbPulse" Storyboard.TargetProperty="ScaleY" From="1" To="1.012" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Grid>
    <!-- ======================================================= ambient background -->
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#0A1D34" Offset="0" />
          <GradientStop Color="#071120" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-200,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#3837A0F4" Offset="0" />
            <GradientStop Color="#0037A0F4" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1T" /></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-260">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#38697ECD" Offset="0" />
            <GradientStop Color="#00697ECD" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2T" /></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,120,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#382B7BE1" Offset="0" />
            <GradientStop Color="#002B7BE1" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="Blob3T" /></Ellipse.RenderTransform>
      </Ellipse>
      <Canvas x:Name="StarsCanvas" />
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ======================================================= glass navigation -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,24,16,16">
          <StackPanel DockPanel.Dock="Top" Margin="8,0,0,26">
            <StackPanel Orientation="Horizontal">
              <Grid Width="30" Height="30">
                <Ellipse>
                  <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                      <GradientStop Color="#9FD5CC" Offset="0" />
                      <GradientStop Color="#B1BEDE" Offset="0.7" />
                      <GradientStop Color="#EECEB9" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
              </Grid>
              <TextBlock Text="TIREXNET" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Windows edition" Style="{StaticResource Caption}" Margin="40,2,0,0" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border CornerRadius="12" Background="#14FFFFFF" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="{StaticResource DimBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SideStatus" Text="Offline" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="AdminBadge" Style="{StaticResource Caption}" Margin="6,0,0,4" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Foreground="{StaticResource DimBrush}" Margin="6,0,0,0" />
          </StackPanel>

          <StackPanel>
            <RadioButton x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="OnNavChecked" Tag="Dashboard" local:Ico.Data="M3,11 L12,3 L21,11 M5,9.5 V20 H19 V9.5" />
            <RadioButton x:Name="NavProfiles" Content="Profiles" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNavChecked" Tag="Profiles" local:Ico.Data="M4,5 H20 V10 H4 Z M4,14 H20 V19 H4 Z M7,7.5 H7.01 M7,16.5 H7.01" />
            <RadioButton x:Name="NavAccount" Content="Account" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNavChecked" Tag="Account" local:Ico.Data="M12,11 A4,4 0 1 0 12,3 A4,4 0 1 0 12,11 M4,21 C4,16.5 8,14 12,14 C16,14 20,16.5 20,21" />
            <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNavChecked" Tag="Settings" local:Ico.Data="M12,15 A3,3 0 1 0 12,9 A3,3 0 1 0 12,15 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M5,5 L7,7 M17,17 L19,19 M5,19 L7,17 M17,7 L19,5" />
            <RadioButton x:Name="NavLogs" Content="Logs &amp; diagnostics" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNavChecked" Tag="Logs" local:Ico.Data="M5,20 V11 M12,20 V4 M19,20 V14" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ======================================================= pages -->
      <Grid Grid.Column="1" Margin="32,26,32,22">

        <!-- Dashboard -->
        <Grid x:Name="PageDashboard">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>

          <!-- hero -->
          <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="StatusChip" HorizontalAlignment="Center" CornerRadius="12" Padding="14,5" BorderThickness="1" BorderBrush="{StaticResource StrokeBrush}" Background="#14FFFFFF">
              <TextBlock x:Name="StatusChipText" Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            </Border>

            <!-- connect orb (visual identity of ConnectOrb.kt: pastel sphere, warm/cool halo, breathing pulse) -->
            <Grid x:Name="OrbRoot" Width="230" Height="230" Margin="0,20,0,18" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="OrbHover" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
              <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="OrbPulse" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                <Ellipse x:Name="OrbHalo" Margin="-6" />
                <Ellipse x:Name="OrbBody" Width="180" Height="180" />
                <Ellipse x:Name="OrbRim" Width="180" Height="180" StrokeThickness="3" Fill="Transparent" />
                <Ellipse x:Name="OrbSpinner" Width="204" Height="204" Fill="Transparent" StrokeThickness="3" StrokeDashArray="5 9"
                         StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource CyanBrush}" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform x:Name="SpinRot" /></Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Path Width="46" Height="46" Stretch="Uniform" Stroke="{StaticResource OrbInkBrush}" StrokeThickness="2.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2.5 V12 M6.2,6.2 A8.2,8.2 0 1 0 17.8,6.2" HorizontalAlignment="Center" />
                  <TextBlock x:Name="ConnectLabel" Text="CONNECT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OrbInkBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
              <Button x:Name="ConnectButton" Style="{StaticResource OrbHitButton}" Width="190" Height="190" Click="OnConnectClick"
                      MouseEnter="OnOrbEnter" MouseLeave="OnOrbLeave" PreviewMouseLeftButtonDown="OnOrbDown" PreviewMouseLeftButtonUp="OnOrbUp"
                      AutomationProperties.Name="Connect or disconnect" />
            </Grid>

            <TextBlock x:Name="StatusText" Text="Start your connection" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="StatusDetail" Text="Select a server and press the orb." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="HeroTimer" Text="00:00:00" FontFamily="Consolas" FontSize="22" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />

            <!-- Proxy / VPN -->
            <Border HorizontalAlignment="Center" Margin="0,22,0,0" CornerRadius="14" Padding="3" Background="#14FFFFFF" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeProxy" Content="Proxy" Style="{StaticResource SegButton}" GroupName="mode" Checked="OnModeChanged" />
                <RadioButton x:Name="ModeVpn" Content="VPN" Style="{StaticResource SegButton}" GroupName="mode" Checked="OnModeChanged" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ModeHint" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,8,0,0" HorizontalAlignment="Center" />
            <Button x:Name="AdminButton" Content="Restart as administrator" Style="{StaticResource GhostButton}" Click="OnRestartAdmin" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,10,0,0" />
          </StackPanel>

          <!-- selected server + server list -->
          <DockPanel Grid.Row="0" Grid.Column="1" Margin="22,0,0,16" LastChildFill="True">
            <Border DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="SELECTED SERVER" Style="{StaticResource Overline}" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="46" Height="46">
                    <Ellipse Fill="#22FFFFFF" Stroke="{StaticResource BadgeRingBrush}" StrokeThickness="2.2" />
                    <TextBlock x:Name="SelectedBadgeText" Text="—" Foreground="{StaticResource IceBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedName" Text="No profile selected" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedInfo" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SERVERS" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                <TextBlock x:Name="DashEmptyHint" DockPanel.Dock="Bottom" Text="No servers yet. Add one on the Profiles page or sign in on the Account page." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <ListBox x:Name="DashProfileList" ItemTemplate="{StaticResource ProfileTemplate}" SelectionChanged="OnDashSelectionChanged" />
              </DockPanel>
            </Border>
          </DockPanel>

          <!-- live stats -->
          <UniformGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Columns="4" Margin="0,4,0,0">
            <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0" Padding="16,12">
              <StackPanel>
                <TextBlock Text="SESSION" Style="{StaticResource Overline}" />
                <TextBlock x:Name="DurationText" Text="00:00:00" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0" Padding="16,12">
              <StackPanel>
                <TextBlock Text="DOWNLOAD" Style="{StaticResource Overline}" />
                <TextBlock x:Name="DownText" Text="0 B/s" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0" Padding="16,12">
              <StackPanel>
                <TextBlock Text="UPLOAD" Style="{StaticResource Overline}" />
                <TextBlock x:Name="UpText" Text="0 B/s" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Padding="16,12">
              <StackPanel>
                <TextBlock Text="TOTAL (DOWN / UP)" Style="{StaticResource Overline}" />
                <TextBlock x:Name="TotalText" Text="0 B / 0 B" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </Grid>

        <!-- Profiles -->
        <Grid x:Name="PageProfiles" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
          <WrapPanel Grid.Row="1" Margin="0,14,0,8">
            <Button Content="Paste from clipboard" Style="{StaticResource NeonButton}" Click="OnImportClipboard" />
            <Button Content="Add link…" Style="{StaticResource GhostButton}" Click="OnImportUri" />
            <Button Content="MHRV profile…" Style="{StaticResource GhostButton}" Click="OnCreateMhrv" />
            <Button Content="Import file…" Style="{StaticResource GhostButton}" Click="OnImportFile" />
            <Button x:Name="PingAllButton" Content="Ping all" Style="{StaticResource GhostButton}" Click="OnPingAll" />
            <Button x:Name="SmartConnectButton" Content="Smart connect" Style="{StaticResource GhostButton}" Click="OnSmartConnect" />
            <Button Content="Rename" Style="{StaticResource GhostButton}" Click="OnRename" />
            <Button Content="Edit" Style="{StaticResource GhostButton}" Click="OnEdit" />
            <Button Content="Export" Style="{StaticResource GhostButton}" Click="OnExport" />
            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="OnDelete" />
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource GlassCard}">
            <Grid>
              <ListBox x:Name="ProfilesList" ItemTemplate="{StaticResource ProfileTemplate}" SelectionChanged="OnProfilesSelectionChanged" />
              <TextBlock x:Name="ProfilesEmptyHint" Text="No profiles yet. Paste a vless://, vmess://, trojan://, ss:// or slipnet:// link, import a WireGuard / AmneziaWG .conf, OpenVPN .ovpn or Xray JSON file, or sign in on the Account page."
                         Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Border>
          <TextBlock Grid.Row="3" x:Name="ProfileDetail" Style="{StaticResource Caption}" Margin="4,12,0,0" TextWrapping="Wrap" />
        </Grid>

        <!-- Account -->
        <ScrollViewer x:Name="PageAccount" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="580" HorizontalAlignment="Left">
            <TextBlock Text="Account" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Sign in to your TIREXNET subscription to load your servers automatically." Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" />
            <Border Style="{StaticResource GlassCard}">
              <StackPanel>
                <TextBlock Text="PANEL" Style="{StaticResource Overline}" />
                <Border HorizontalAlignment="Left" Margin="0,8,0,12" CornerRadius="14" Padding="3" Background="#14FFFFFF" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PanelPasarGuard" Content="PasarGuard · Xray" Style="{StaticResource SegButton}" GroupName="panel" IsChecked="True" Checked="OnPanelChanged" />
                    <RadioButton x:Name="PanelAli" Content="AliPanel · WireGuard" Style="{StaticResource SegButton}" GroupName="panel" Checked="OnPanelChanged" />
                  </StackPanel>
                </Border>
                <TextBlock x:Name="PanelStatus" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                <StackPanel x:Name="LoginForm">
                  <TextBlock Text="Username" Style="{StaticResource Caption}" />
                  <TextBox x:Name="LoginUser" Margin="0,5,0,12" />
                  <TextBlock Text="Password" Style="{StaticResource Caption}" />
                  <PasswordBox x:Name="LoginPass" Margin="0,5,0,14" KeyDown="OnLoginKeyDown" />
                  <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource NeonButton}" Click="OnSignIn" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="AccountInfoPanel" Visibility="Collapsed">
                  <TextBlock x:Name="AccountText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="21" />
                  <WrapPanel>
                    <Button Content="Refresh &amp; sync servers" Style="{StaticResource NeonButton}" Click="OnSync" />
                    <Button Content="Sign out" Style="{StaticResource GhostButton}" Click="OnSignOut" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="AccountMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="Account creation is not available in the Windows app yet. Sessions are stored encrypted for your Windows user." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,12,0,0" />
          </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="660" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Local proxy" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Listeners are bound to 127.0.0.1 only and are never reachable from other devices." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="SOCKS5 port" Style="{StaticResource Caption}" />
                    <TextBox x:Name="SetSocks" Margin="0,5,0,0" InputScope="Number" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="HTTP proxy port" Style="{StaticResource Caption}" />
                    <TextBox x:Name="SetHttp" Margin="0,5,0,0" InputScope="Number" />
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="SetEnableHttp" Content="Enable the HTTP proxy" Margin="0,14,0,0" />
                <CheckBox x:Name="SetSysProxy" Content="Set the Windows system proxy while connected (proxy mode, restored on disconnect)" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="DNS &amp; network" Style="{StaticResource CardTitle}" />
                <TextBlock Text="DNS servers (comma separated, empty = profile / system default)" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <TextBox x:Name="SetDns" Margin="0,5,0,8" />
                <WrapPanel>
                  <Button Content="Cloudflare" Style="{StaticResource GhostButton}" Click="OnDnsPreset" Tag="1.1.1.1, 1.0.0.1" />
                  <Button Content="Google" Style="{StaticResource GhostButton}" Click="OnDnsPreset" Tag="8.8.8.8, 8.8.4.4" />
                  <Button Content="Quad9" Style="{StaticResource GhostButton}" Click="OnDnsPreset" Tag="9.9.9.9, 149.112.112.112" />
                  <Button Content="Default" Style="{StaticResource GhostButton}" Click="OnDnsPreset" Tag="" />
                </WrapPanel>
                <TextBlock Text="MTU (0 = default)" Style="{StaticResource Caption}" />
                <TextBox x:Name="SetMtu" Margin="0,5,0,12" Width="130" HorizontalAlignment="Left" />
                <TextBlock Text="Networks that bypass the VPN (IPv4 CIDR, one per line) — VPN mode with Xray" Style="{StaticResource Caption}" />
                <TextBox x:Name="SetBypass" AcceptsReturn="True" Height="80" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" />
                <Separator Margin="0,14,0,12" Opacity="0.35" />
                <TextBlock Text="Application split tunneling" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Select executable files and save an Include or Exclude policy. Per-application traffic steering is not active until the dedicated Windows filtering component is installed." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,8" />
                <ComboBox x:Name="SetSplitMode" Width="220" HorizontalAlignment="Left" SelectedIndex="1" Margin="0,0,0,8">
                  <ComboBoxItem Content="Include selected apps" Tag="include" />
                  <ComboBoxItem Content="Exclude selected apps" Tag="exclude" />
                </ComboBox>
                <TextBox x:Name="SetSplitApps" AcceptsReturn="True" Height="105" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto" ToolTip="One full executable path per line" />
                <Button Content="Add application executable…" Style="{StaticResource GhostButton}" Click="OnAddSplitApplication" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Application" Style="{StaticResource CardTitle}" />
                <CheckBox x:Name="SetCloseToTray" Content="Keep running in the system tray when the window is closed" Margin="0,10,0,0" />
                <CheckBox x:Name="SetStartMin" Content="Start minimized to the tray" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="UpdVersion" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <CheckBox x:Name="SetUpdAuto" Content="Check for updates automatically" Margin="0,10,0,0" />
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Channel" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="SetUpdChannel" Margin="0,5,0,0">
                      <ComboBoxItem Content="Stable" Tag="stable" />
                      <ComboBoxItem Content="Beta" Tag="beta" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Check every (hours)" Style="{StaticResource Caption}" />
                    <TextBox x:Name="SetUpdHours" Margin="0,5,0,0" InputScope="Number" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Update manifest (https)" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                <TextBox x:Name="SetUpdUrl" Margin="0,5,0,10" />
                <WrapPanel>
                  <Button x:Name="UpdCheckBtn" Content="Check now" Style="{StaticResource GhostButton}" Click="OnUpdateCheck" />
                  <Button x:Name="UpdInstallBtn" Content="Download and install" Style="{StaticResource NeonButton}" Click="OnUpdateInstall" Visibility="Collapsed" />
                  <Button x:Name="UpdCancelBtn" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnUpdateCancel" Visibility="Collapsed" />
                </WrapPanel>
                <ProgressBar x:Name="UpdProgress" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="UpdStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Engines" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="EngineStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap" Margin="4,0,0,10" Foreground="{StaticResource MutedBrush}" />
            <Button Content="Save settings" Style="{StaticResource NeonButton}" Click="OnSaveSettings" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>

        <!-- Logs -->
        <Grid x:Name="PageLogs" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Logs &amp; diagnostics" Style="{StaticResource PageTitle}" />
          <WrapPanel Grid.Row="1" Margin="0,14,0,8">
            <Button x:Name="DiagButton" Content="Run diagnostics" Style="{StaticResource NeonButton}" Click="OnDiagnostics" />
            <Button Content="Copy" Style="{StaticResource GhostButton}" Click="OnCopyLogs" />
            <Button Content="Clear" Style="{StaticResource GhostButton}" Click="OnClearLogs" />
            <Button Content="Open log folder" Style="{StaticResource GhostButton}" Click="OnOpenLogFolder" />
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="6">
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
